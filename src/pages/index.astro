---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import homeData from "../data/homeData.json";
import SiteStats from "../components/SiteStats.astro";

const posts = (await getCollection("blog"))
  .map((post) => ({
    ...post,
    category:
      post.data.category ||
      (post.id.includes("/") ? post.id.split("/")[0] : "文章"),
    timestamp: post.data.pubDate ? new Date(post.data.pubDate).getTime() : 0,
  }))
  .sort((a, b) => b.timestamp - a.timestamp);

const NOW = Date.now();
const NINETY_DAYS = 90 * 24 * 60 * 60 * 1000;
const recent = posts.filter((post) => NOW - post.timestamp <= NINETY_DAYS);
const selectedPosts =
  recent.length < 3 ? posts.slice(0, 3) : recent.slice(0, 5);

const recentPosts = selectedPosts.map((post, index) => ({
  num: String(index + 1).padStart(2, "0"),
  category: post.category,
  date: post.data.pubDate
    ? new Date(post.data.pubDate).toLocaleDateString("zh-CN", {
        month: "long",
        day: "numeric",
      })
    : "",
  title: post.data.title,
  slug: post.id,
}));

const { thoughts, letters } = homeData;
---

<BaseLayout title="Yutachi - 台官忽奏文昌现">
  <div class="scroll-container">
    <section class="hero-section">
      <div class="avatar-wrapper">
        <img src="/photo/tx.jpg" alt="Avatar" class="avatar" />
      </div>
      <h1 class="greeting serif-font">
        Hi, I'm <span class="highlight">
          <a href="/blog/文章/about-me" title="about-me" class="sayaka-link"
            >Sayaka</a
          >
        </span>
      </h1>

      <p class="subtitle serif-font">
        I collaborate <span class="italic-text">with AI</span> to turn ideas into
        <span class="glow-tag">REALITY.</span>
      </p>

      <p class="description">
        WE GO TO THE MOON NOT BECAUSE IT IS EASY, BUT BECAUSE IT IS HARD_
      </p>
    </section>

    <section class="meta-section">
      <p class="quote serif-font">
        「我们选择去登月，不是因为它很容易，而是因为它们困难」
      </p>
      <div class="stats">
        <SiteStats />
      </div>
      <div class="social-icons">
        <a href="mailto:Bellflowere@proton.me" title="Email" class="social-smallcaps">Email</a>
        <a href="https://x.com/Iceberja" title="X">𝕏</a>
        <a href="https://github.com/sakuya-susuki" title="Github">Github</a>
      </div>
    </section>

    <section class="homepage-columns">
      <div class="column left-column">
        <div class="sub-section">
          <div class="column-header">
            <span class="sub-title">MUSINGS</span>
            <h2>碎念</h2>
          </div>
          <div class="thoughts-wrapper">
            {
              thoughts.map((t) => (
                <div class="thought-card">
                  <p class="thought-text">{t.content}</p>
                  <span class="thought-date">{t.date}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="sub-section">
          <div class="column-header">
            <span class="sub-title">LETTERS</span>
            <h2>TO ME</h2>
          </div>
          <div class="letters-wrapper">
            {
              letters.map((l) => (
                <div class="letter-card">
                  <p class="letter-text serif-font">“ {l.text} ”</p>
                  {l.meta && <span class="letter-meta">听 {l.meta}</span>}
                  <span class="letter-author">— {l.author}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="column right-column">
        <div class="column-header">
          <span class="sub-title">RECENT WRITI</span>
          <h2>近期笔墨</h2>
        </div>
        <ol class="timeline">
          {
            recentPosts.map((post) => (
              <li class="timeline-item">
                <span class="timeline-num">{post.num}</span>
                <div class="timeline-body">
                  <div class="post-meta">
                    <span class="category-tag">{post.category}</span> ·{" "}
                    <span class="time">{post.date}</span>
                  </div>
                  <a href={`/blog/${post.slug}`} class="post-title serif-font">
                    {post.title}
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <footer class="scroll-footer">
      <h2 class="footer-title">This not End.</h2>
      <div class="decorative-dots">
        <span>⟡</span><span></span><span>·</span><span>·</span><span>·</span
        ><span>·</span><span>·</span><span>·</span><span>·</span><span>·</span
        ><span>⟡</span>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .scroll-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 80px 24px 120px 24px;
    display: flex;
    flex-direction: column;
    gap: 100px;
  }

  .hero-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 2px solid var(--border-color);
  }

  .greeting {
    font-size: 2.2em;
    font-weight: 600;
    color: var(--text-color);
  }

  .highlight {
    color: var(--accent-color);
    font-weight: 700;
  }

  .sayaka-link {
    color: inherit;
    text-decoration: none;
  }

  .sayaka-link:hover {
    text-decoration: underline;
  }

  .subtitle {
    font-size: 1.4em;
    color: var(--text-color);
    opacity: 0.9;
  }

  .italic-text {
    font-style: italic;
    font-family: Georgia, serif;
    color: var(--accent-color);
  }

  .glow-tag {
    background: rgba(244, 63, 94, 0.08);
    color: var(--accent-color);
    padding: 2px 10px;
    border-radius: var(--radius-lg);
    font-size: 0.9em;
    border: 1px solid rgba(244, 63, 94, 0.15);
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-weight: 700 !important;
  }

  .description {
    font-size: 0.75em;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    max-width: 500px;
    line-height: 1.8;
  }

  .meta-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }

  .quote {
    font-family: "Noto Serif SC", Georgia, serif;
    font-style: italic;
    font-size: 0.85em;
    color: var(--text-muted);
  }

  .stats {
    font-size: 0.8em;
    color: var(--text-muted);
  }

  .social-icons {
    display: flex;
    gap: 20px;
  }

  .social-icons a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 1.1em;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .social-icons a:hover {
    color: var(--text-color);
    transform: translateY(-1px);
  }

  /* E 大、mail 小：CSS 小型大写字母技巧 */
    font-size: 0.7em;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .column-header h2 {
    font-size: 1.3em;
    margin: 5px 0 0 0;
    font-weight: 500;
    color: var(--text-color);
  }

  .timeline {
    position: relative;
    border-left: 1px dashed var(--border-color);
    padding-left: 30px;
    margin-left: 12px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-num {
    position: absolute;
    left: -42px;
    top: 2px;
    background: var(--bg-color);
    color: var(--accent-color);
    font-size: 0.7em;
    padding: 0 4px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xs);
    font-family: monospace;
  }

  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-align: left;
  }

  .post-meta {
    font-size: 0.75em;
    color: var(--text-muted);
  }

  .category-tag {
    color: var(--accent-color);
  }

  .post-title,
  .post-title:visited {
    font-family:
      "Noto Serif SC", "Source Han Serif SC", "STSong", "SimSun", Georgia, serif !important;
    font-size: 1.15rem !important;
    color: var(--text-color) !important;
    text-decoration: none !important;
    line-height: 1.5;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .post-title:hover,
  .post-title:active {
    color: var(--accent-color) !important;
    text-decoration: underline !important;
  }

  .thoughts-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .thought-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
  }

  .thought-text {
    margin: 0;
    font-size: 0.9em;
    line-height: 1.6;
    color: var(--text-color);
  }

  .thought-date {
    font-size: 0.75em;
    color: var(--text-muted);
  }

  .letters-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .letter-card {
    background: rgba(128, 128, 128, 0.05);
    border-left: 2px solid var(--border-color);
    padding: 16px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition:
      border-color var(--transition-normal),
      background-color var(--transition-color);
    text-align: left;
  }

  .letter-card:hover {
    border-left-color: var(--accent-color);
  }

  .letter-text {
    margin: 0;
    font-family: "Noto Serif SC", Georgia, serif;
    font-size: 0.95em;
    line-height: 1.7;
    color: var(--text-color);
  }

  .letter-meta {
    font-size: 0.75em;
    color: var(--text-muted);
  }

  .letter-author {
    font-size: 0.75em;
    align-self: flex-end;
    color: var(--text-muted);
  }

  .scroll-footer {
    text-align: center;
    margin-top: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .footer-title {
    font-family: "Noto Serif SC", Georgia, serif;
    font-size: 1.2em;
    font-weight: 400;
    letter-spacing: 0.5em;
    color: var(--text-muted);
    margin-left: 0.5em;
  }

  .decorative-dots {
    color: var(--border-color);
    font-size: 0.8em;
    letter-spacing: 0.8em;
    margin-left: 0.8em;
  }

  @media (max-width: 768px) {
    .scroll-container {
      padding: 40px 20px 80px 20px !important;
      gap: 60px !important;
    }

    .homepage-columns {
      flex-direction: column !important;
      gap: 60px !important;
    }

    .column {
      width: 100% !important;
    }
  }
</style>
