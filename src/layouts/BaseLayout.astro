---
// src/layouts/BaseLayout.astro
const { title = "Yutachi", description = "台官忽奏文昌现" } = Astro.props;
// 获取当前网页的路径
const currentPath = Astro.url.pathname;
// 判断用户是否正处于首页及各个子栏目
const isHome = currentPath === "/" || currentPath === "/index.html";
const isPosts = currentPath.startsWith("/posts");
const isTimeline = currentPath.startsWith("/timeline");

// 引入样式：tokens（变量）→ layout（全局布局）→ font（字体）→ article（文章专用）
import "../styles/tokens.css";
import "../styles/layout.css";
import "../styles/font.css";
import "../styles/article.css";
// 引入组件
import ThemeToggle from "../components/ThemeToggle.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- 思源宋体：preload + onload 非阻塞加载，消除渲染阻塞，提升 FCP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;700&display=swap"
      />
    </noscript>
  </head>
  <body>
    <!-- 1. 粒子背景 -->
    <canvas id="particle-canvas"></canvas>

    <!-- 2. 顶部全局导航栏 -->
    <header class="header">
      <nav class="nav">
        <!-- 左侧：极简品牌名 -->
        <div class="nav-left">
          <a href="/" class="logo serif-font">K_SAY.</a>
        </div>

        <!-- 中间：可折叠文字菜单 -->
        <div id="nav-menu-wrapper" class="nav-menu-wrapper">
          <div class="nav-center">
            <a href={isHome ? "#" : "/"} class={isHome ? "active" : ""}>首</a>
            <a href="/posts" class={isPosts ? "active" : ""}>文</a>
            <a href="/timeline" class={isTimeline ? "active" : ""}>忆往昔</a>
            <a href="/posts?cat=记">记</a>
            <a href="/posts?cat=思">思</a>
          </div>
        </div>

        <div class="nav-actions">
          <ThemeToggle />
          <button id="mobile-menu-btn" class="hamburger-btn" aria-label="菜单">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- 3. 页面内容注入点 -->
    <main>
      <slot />
    </main>

    <!-- 4. 重构后的精致长卷轴页脚 (Footer) -->
    <footer class="footer">
      <div class="footer-container">
        <!-- 4.1 互动呼吁区域 -->
        <div class="footer-action-zone">
          <div class="action-title serif-font">
            <span id="dynamic-greeting">仲夏蝉鸣</span>
            <span class="action-title serif-font"></span>
            <span class="pink-dot">●</span>
          </div>

          <div class="action-grid">
            <div class="action-item">
              <span class="action-label">不要悲伤</span>
            </div>
            <div class="vertical-divider"></div>
            <div class="action-item">
              <span class="action-label"></span>
              <span class="action-sub italic-text">我们总会相遇</span>
            </div>
          </div>

          <div class="action-sublinks">
            <a href="/tome">来信</a> · <a href="/friends">朋友们</a> · <a
              href="/bookcase">书柜</a
            >
          </div>
        </div>

        <hr class="footer-line" />

        <!-- 4.2 底部站点地图区域 (双列) -->
        <div class="footer-meta-grid">
          <div class="meta-left">
            <h3 class="brand-logo">Yutachi</h3>
            <p class="brand-motto italic-text">.</p>
            <p class="copyright">© 2024-2026 Powered by Sayaka & Astro</p>
            <!-- <p class="live-counter"><span class="green-dot">●</span></p> -->
          </div>

          <!-- 右侧：分类链接列表 -->
          <div class="meta-right-links">
            <div class="link-group">
              <h4>关于</h4>
              <a href="/Yutachi">关于本站此项目</a>
              <a href="/blog/文章/about-me">关于我</a>
            </div>
            <div class="link-group">
              <h4>更多</h4>
              <a href="/photos">照片廊</a>
              <a href="/friends">友链</a>
              <!-- <a href="login">登记</a> -->
            </div>
            <div class="link-group">
              <h4>联系</h4>
              <a href="#">留言</a>
              <a href="mailto:2095368893@qq.com">邮件 ↗</a>
              <a href="https://github.com/sakuya-susuki">GitHub ↗</a>
            </div>
          </div>
        </div>

        <!-- 4.3 底部最后一行 (合规栏已安全注释) -->
        <div class="footer-compliance-row">
          <div class="compliance-left">
            <!-- <a href="#">RSS 订阅</a> · <a href="#">站点地图</a> · <a href="#">Light · System · Dark</a> -->
          </div>
          <div class="compliance-right">
            <!-- <span>萌ICP备20236136号</span> -->
          </div>
        </div>
      </div>
    </footer>

    <!-- 粒子背景脚本 -->
    <script>
      const canvas = document.getElementById(
        "particle-canvas",
      ) as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext("2d")!;
        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        const PARTICLE_COUNT = 50; // 粒子总数，可按需调整

        // ── 粒子类 ──────────────────────────────────
        class Particle {
          x = 0;
          y = 0;
          size = 0;
          speedX = 0;
          speedY = 0;
          alpha = 0;
          color = "";

          constructor() {
            this.reset(true);
          }

          reset(init = false) {
            this.x = Math.random() * width;
            this.y = init ? Math.random() * height : -10;
            this.size = Math.random() * 1.2 + 0.5;
            this.speedX = (Math.random() - 0.5) * 0.1;
            this.speedY = Math.random() * 0.15 + 0.08;
            this.alpha = Math.random() * 0.35 + 0.08;
            // 20% 概率为蔷薇粉，其余为雾灰色
            this.color =
              Math.random() > 0.8
                ? `rgba(244, 63, 94, ${this.alpha})`
                : `rgba(226, 232, 240, ${this.alpha})`;
          }

          update() {
            this.x += this.speedX;
            this.y += this.speedY;
            // 越界后从顶部重置，实现循环飘落
            if (this.y > height + 10 || this.x < -10 || this.x > width + 10)
              this.reset();
          }

          draw() {
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        // ── 初始化 ──────────────────────────────────
        const particles: Particle[] = Array.from(
          { length: PARTICLE_COUNT },
          () => new Particle(),
        );

        // ── 动画循环 ─────────────────────────────────
        function animate() {
          ctx.clearRect(0, 0, width, height);
          particles.forEach((p) => {
            p.update();
            p.draw();
          });
          requestAnimationFrame(animate);
        }

        // ── resize 防抖：避免窗口拖拽时频繁重计算 ──
        let resizeTimer: ReturnType<typeof setTimeout>;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
          }, 150);
        });

        animate();
      }
    </script>

    <!-- 动态时辰计算脚本 -->
    <script is:inline>
      function updateTimeGreeting() {
        const greetingElement = document.getElementById("dynamic-greeting");
        if (!greetingElement) return;

        const hour = new Date().getHours();
        let greeting = "仲夏蝉鸣";

        if (hour >= 5 && hour < 9) {
          greeting = "晨光熹微";
        } else if (hour >= 9 && hour < 12) {
          greeting = "微风和煦";
        } else if (hour >= 12 && hour < 17) {
          greeting = "暖阳午后";
        } else if (hour >= 17 && hour < 19) {
          greeting = "落日黄昏";
        } else if (hour >= 19 && hour < 23) {
          greeting = "万家灯火";
        } else {
          greeting = "夜深静谧";
        }

        greetingElement.innerText = greeting;
      }
      updateTimeGreeting();
    </script>

    <!-- 移动端 -->
    <script is:inline>
      function setupMobileMenu() {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("nav-menu-wrapper");

        if (!btn || !menu) return;

        // 1. 清除可能残留的旧事件（防止页面切换时重复绑定导致闪烁）
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);

        // 2. 绑定点击展开/收起
        newBtn.addEventListener("click", () => {
          menu.classList.toggle("open");
        });

        // 3. 点击菜单内链接后自动收起
        menu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => menu.classList.remove("open"));
        });
      }

      // 无论页面怎么加载，保证 100% 绑定成功
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupMobileMenu);
      } else {
        setupMobileMenu();
      }

      // 兼容 Astro 的无缝换页功能
      document.addEventListener("astro:page-load", setupMobileMenu);
      document.addEventListener("astro:after-swap", setupMobileMenu);
    </script>
  </body>
</html>
